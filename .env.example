# HoosLog — .env.example (committed template; copy to .env.local and fill)
# =====================================================================
# HOW TO USE
# 1. This is the COMMITTED template — placeholders only, never real values.
# 2. When the repo is scaffolded: save this as `.env.example` in the root,
#    then copy it to `.env.local` and fill in real values there.
# 3. `.env.local` is NEVER committed. create-next-app's default .gitignore
#    excludes `.env*` — verify that line exists before your first push.
# 4. Real values live in exactly two places: `.env.local` and your
#    password manager. Not in chat, not in the docs folder, not in Vercel
#    until deploy day (then: Vercel → Project → Settings → Environment Variables).
# =====================================================================

# --- Supabase (Dashboard → Project Settings → API) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable/anon key — safe in the browser BY DESIGN: Row-Level Security
# is the actual security boundary, which is why RLS is on from migration one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Secret/service-role key — SERVER ONLY. Bypasses RLS entirely.
# Never prefix with NEXT_PUBLIC_. Used only by admin scripts and the
# plan-importer job, never by anything a browser touches.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-OR-SERVICE-ROLE-KEY

# --- App --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Build week (create these keys when the feature is built, not before) ---
# RESEND_API_KEY=                 # email fallback for notifications
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # web push (deadline reminders)
# VAPID_PRIVATE_KEY=

# --- Phase 2 only — locked decision 17 / doc 08 §1 --------------------
# Do NOT create this key yet. The importer is deterministic-first; this
# exists only if the coach's real Excel proves too messy to parse without AI.
# ANTHROPIC_API_KEY=

# --- Deliberately absent ----------------------------------------------
# GITHUB_PAT — the app never calls the GitHub API. Git auth on your
# machine = `gh auth login` / Git Credential Manager, not an env var.
